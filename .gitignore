# Things Git should NOT track (secrets, junk, generated files)

# Python virtual environment (huge, machine-specific)
backend/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Environment secrets
.env
backend/.env

# Local SQLite database file (created when the app runs)
backend/*.db
backend/**/*.db

# OS / editor junk
.DS_Store
.idea/
.vscode/

# Frontend (later)
frontend/node_modules/
frontend/dist/
